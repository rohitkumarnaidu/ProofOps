# --- ProofOps environment template (copy to .env, never commit .env) ---
# SAFE config inspection (never prints values): `docker compose config --quiet`
#   (validates only) or `docker compose config --services` (names only).
# UNSAFE: plain `docker compose config` resolves env_file and PRINTS SECRET
#   VALUES (e.g. APPROVAL_SECRET) to stdout — never use in CI logs/demos.
# Lyzr (Step 1 connectivity; leave blank to run on local mock fallback)
LYZR_API_KEY=
# Single-agent id used by scripts/verify_lyzr.py (LYZR_AGENT_ID).
LYZR_AGENT_ID=
# Per-agent ids (FUTURE, M13 Lyzr agents; unused by code today but reserved):
LYZR_AGENT_TRIAGE_ID=
LYZR_AGENT_DIAGNOSTIC_ID=
LYZR_AGENT_PLANNER_ID=
LYZR_AGENT_REPORTER_ID=
LYZR_RAI_POLICY=PS03-Governed

# Control plane
EXECUTOR=mock
APPROVAL_SECRET=change-me-generate-with-python-secrets-token_hex-32
APPROVAL_TTL_SECONDS=600
POLICY_VERSION=v1

# Database (docker compose)
POSTGRES_USER=proofops
POSTGRES_PASSWORD=***REMOVED***
POSTGRES_DB=proofops
DATABASE_URL=postgresql+psycopg://proofops:***REMOVED***@db:5432/proofops

# Demo / eval
SEED_SCENARIO=bad-deploy
SEED_VARIANT=NORMAL
SEED_SEED=42

# API auth (dev defaults only)
PROOFOPS_API_KEY=dev-key-change-me
