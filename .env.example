# --- ProofOps environment template (copy to .env, never commit .env) ---
# SAFE config inspection (never prints values): `docker compose config --quiet`
#   (validates only) or `docker compose config --services` (names only).
# UNSAFE: plain `docker compose config` resolves env_file and PRINTS SECRET
#   VALUES (e.g. APPROVAL_SECRET) to stdout — never use in CI logs/demos.
# --- Application mode (M00.2 configuration trust boundary) ---
# APP_ENV: development | test | demo | production. Production fails closed:
#   real APPROVAL_SECRET, DEBUG=false, explicit API/DB secrets, no mock executor.
APP_ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (consumed by logging in M00.5).
LOG_LEVEL=INFO
# DEBUG: never true in production (fail-closed).
DEBUG=false
# Lyzr (Step 1 connectivity; leave blank to run on local mock fallback)
LYZR_API_KEY=
# Single-agent id used by scripts/verify_lyzr.py (LYZR_AGENT_ID).
LYZR_AGENT_ID=
# Per-agent ids (FUTURE, M13 Lyzr agents; unused by code today but reserved):
LYZR_AGENT_TRIAGE_ID=
LYZR_AGENT_DIAGNOSTIC_ID=
LYZR_AGENT_PLANNER_ID=
LYZR_AGENT_REPORTER_ID=
LYZR_RAI_POLICY=PS03-Governed

# Control plane
EXECUTOR=mock
APPROVAL_SECRET=change-me-generate-with-python-secrets-token_hex-32
APPROVAL_TTL_SECONDS=600
POLICY_VERSION=v1

# Database (docker compose). No default passwords ship here: POSTGRES_PASSWORD
# is REQUIRED in .env (compose fails closed with :? if unset).
POSTGRES_USER=proofops
POSTGRES_PASSWORD=
POSTGRES_DB=proofops
# Format only (no credentials): postgresql+psycopg://USER:PASSWORD@db:5432/DB
DATABASE_URL=

# --- live tier (M08/M09) ---
# Left empty/non-live by default so a clean clone reports the live tier as
# offline rather than claiming a connection it does not have. Run
# `bash scripts/live_tier.sh up` to provision a real Kubernetes API server and a
# real Prometheus, which writes its kubeconfig to var/live/ and overrides these.
# KUBECONFIG is a path, not a credential; the ServiceAccount token beside it is
# mounted read-only and scoped to one namespace.
KUBECONFIG=
KUBERNETES_NAMESPACE=proofops-demo
PROMETHEUS_URL=http://proofops-prometheus:9090
# Set true to execute against the real cluster instead of the mock sandbox.
# Off by default on purpose -- reaching a cluster is not consent to mutate it.
# With it on, a live failure is reported as a live failure; it never downgrades
# to the mock, because a "success" from a dict that never touched the cluster
# would be an audit entry for a remediation that did not happen.
LIVE_CLUSTER=false
# How a single-use approval token reaches the human who must spend it. The
# approvals store deliberately never persists the token, so a carrier is needed.
#   approver_minted (default, strongest) - the control plane mints nothing; the
#     human raises the request from the Safety Gate and gets the token, so no
#     token exists that the approver did not create.
#   out_of_band - the control plane mints and writes the token to a 0600 file
#     outside the API's state dir; the approver reads it and pastes it.
#   scoped_view - weakest: the token is collectable once by an approver/admin via
#     a dedicated audited endpoint. A live credential on a read path, which is
#     why it is not the default.
APPROVAL_TOKEN_DELIVERY=approver_minted

# --- instrumented demo workload (telemetry/demo_service.py) ----------------
# Registered because the env-parity test requires every var the code reads to be
# declared here. These are read inside the demo workload, not the API, and are
# set on its Deployment by scripts/live_tier.sh.
#   PORT               listen port (host-networked, so the node address is used)
#   DEMO_SERVICE       service name attached to the emitted metrics
#   DEMO_STATE_FILE    presence of this file = healthy; absent = returning 5xx
#   DEMO_FAIL_RATE     share of requests that fail while unhealthy
PORT=8082
DEMO_SERVICE=checkout-api
DEMO_STATE_FILE=/tmp/demo-healthy
DEMO_FAIL_RATE=1.0

# Demo / eval
SEED_SCENARIO=bad-deploy
SEED_VARIANT=NORMAL
SEED_SEED=42

# API auth (dev defaults only)
PROOFOPS_API_KEY=dev-key-change-me
