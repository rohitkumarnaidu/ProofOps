# M00.3: keep secrets and junk out of the api build context (repo-root
# context). The api image never COPYs these, but without this file they are
# still SENT to the daemon — including .env (live secrets). Mirrors .gitignore.
.env
.git
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
build/
frontend/dist/
runs/
*.jsonl
!**/suites/*.jsonl
.DS_Store
# NOTE: frontend/ builds from ./frontend (Vite app since M19; verified
# secret-free context: no .env/.pem/key files — re-check if it ever gains
# server-side code or secrets-adjacent files, then it needs its own ignore).
# `!**/suites/*.jsonl` lets benchmark suites ship: the in-image eval runner
# reads them at runtime (M16/M17); everything else jsonl stays out.
