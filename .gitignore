__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
# Env files: every variant is secret EXCEPT the tracked templates, which the
# deployer copies. `.env.example` (root and frontend) must stay visible.
.env
.env.local
.env.*
!.env.example
!**/.env.example
# Key/cert material must never reach the repository, even in a demo.
*.pem
*.key
*.p12
*.pfx
*.crt
# Runtime state (approvals/runs/audit/nonces/keys) — never committed.
# Exception: *.example templates ARE tracked so operators know the shape.
var/*
!var/*.example
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
node_modules/
dist/
build/
frontend/dist/
runs/
*.jsonl
!**/suites/*.jsonl
# Logs, including rotated ones (host runs produce backend.log.1, etc.).
*.log
*.log.*
# Build/caches that only appear after a real dev run.
*.tsbuildinfo
.eslintcache
.direnv/
*.pid
*.orig
*.rej
core
.DS_Store
Thumbs.db
.vscode/
.idea/
.opencode/
.cache/
*.tmp
*.swp
*~
*.db
*.db-shm
*.db-wal
# The app has a declared SQLite fallback (var/proofops.db), and SQLite writes a
# rollback journal beside the database. -wal and -shm were already covered;
# -journal was not, and a journal holds committed page contents, so committing
# one leaks data the database file alone would not.
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
.turbo/
.next/
frontend/.vite/
# Vite writes this next to the config on a dep-optimize pass; it is a cache
# marker, not configuration, and it changes on almost every install.
vite.config.ts.timestamp

# --- editor / OS leftovers that survive a dev run ---
# `.parcelrc` is deliberately NOT ignored: it is configuration someone chose.
# So is `docker-compose.override.yml`, for a sharper reason: an untracked
# override silently changes what `docker compose up` runs versus what CI runs,
# and a divergence the repository cannot see is the kind this project should
# surface rather than absorb. Same for `*.png` -- gate screenshots are covered
# by directory above, and a blanket image rule would hide a real asset later.
*.swo
*.bak
*.save
desktop.ini
.ipynb_checkpoints/
.envrc

# --- test + coverage output (never a source of truth) ---
# `test-results`, `playwright-report`, `blob-report` and `cypress/*` are the
# conventional homes for gate output. The browser gate writes screenshots to
# wherever `--shots` points (docs show ./artifacts), so that is ignored too.
coverage.lcov
.coverage.*
junit.xml
test-results/
playwright-report/
blob-report/
cypress/screenshots/
cypress/videos/
artifacts/
# The browser gate takes a screenshots directory via --shots, and the two names
# below are what people reach for when they do not pass the documented path.
shots/
screenshots/

# --- crash / runaway process output ---
# `core` (exact) was already covered; the kernel also names dumps core.PID, and
# a dev server or the flow gate backgrounded with nohup leaves these behind.
core.*
nohup.out
